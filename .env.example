HOST=127.0.0.1
PORT=4310
DATABASE_PATH=data/part-scout.db
# Required when HOST is not loopback. Use a long random value.
ADMIN_TOKEN=
# Exact hosts allowed for HTTPS JSON feeds. No private IPs or redirects.
FEED_HOSTS=
# Enable only with permission from Car-Part for automated access.
CAR_PART_ENABLED=false
# Notification destinations remain in the environment, never browser storage.
DISCORD_WEBHOOK_URL=
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
# Comma-separated user IDs authorized to control this single-tenant instance.
DISCORD_USER_IDS=
SCOUT_API_URL=http://127.0.0.1:4310
