{
  "name": "part-scout",
  "version": "1.0.0",
  "private": true,
  "description": "A self-hosted parts inventory dashboard and Discord bot.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "demo": "tsx src/demo.ts",
    "bot": "node --env-file-if-exists=.env --import tsx src/bot.ts",
    "bot:register": "node --env-file-if-exists=.env --import tsx src/register.ts",
    "test:browser": "playwright test",
    "migrate": "node --env-file-if-exists=.env --import tsx src/migrate.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "discord.js": "^14.22.1",
    "express": "^5.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
